# Én adresse: https://bjarvik.com. www og http sendes videre hertil.
# /.well-known/ omdirigeres aldrig: Simply bruger den til at forny Let's Encrypt-certifikatet.
ErrorDocument 404 /404.html
RewriteEngine On
RewriteRule ^\.well-known/ - [L]
# MIDLERTIDIGT (4/11-2026): bjarvik.com har endnu ikke sit eget certifikat, så https giver en advarsel.
# Indtil da sendes kun www videre (302, så browsere ikke husker det). Når hængelåsen virker, slettes de to linjer
# herunder, og de tre udkommenterede linjer tages i brug igen.
RewriteCond %{HTTP_HOST} !^bjarvik\.com$ [NC]
RewriteRule ^ http://bjarvik.com%{REQUEST_URI} [R=302,L]
#RewriteCond %{HTTP_HOST} !^bjarvik\.com$ [NC,OR]
#RewriteCond %{HTTPS} off
#RewriteRule ^ https://bjarvik.com%{REQUEST_URI} [R=301,L]
