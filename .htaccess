# Én adresse: https://bjarvik.com. www og http sendes videre hertil.
# /.well-known/ omdirigeres aldrig: Simply bruger den til at forny Let's Encrypt-certifikatet.
ErrorDocument 404 /404.html
RewriteEngine On
RewriteRule ^\.well-known/ - [L]
RewriteCond %{HTTP_HOST} !^bjarvik\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://bjarvik.com%{REQUEST_URI} [R=301,L]
